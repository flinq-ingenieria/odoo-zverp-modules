<odoo>
    <record id="action_all_invoices_calendar" model="ir.actions.act_window">
        <field name="name">invoice.calendar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">calendar</field>
        <field name="context">{}</field>
        <field name="domain">[('move_type', 'in', ['out_invoice', 'in_invoice'])]</field>
    </record>

    <record id="view_account_invoice_calendar_all" model="ir.ui.view">
        <field name="name">account.move.calendar.all</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <calendar string="Invoice Due Dates"
                      color="color_index"
                      date_start="invoice_date_due"
                      mode="month"
                      create="false">
                <field name="invoice_date_due"/>
		<field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="amount_residual"/>
                <field name="move_type"/>
                <field name="payment_state"/>
            </calendar>
        </field>
    </record>

    <menuitem id="menu_all_invoices_calendar"
              name="Invoice calendar"
              parent="account.menu_finance"
              action="action_all_invoices_calendar"/>
</odoo>
