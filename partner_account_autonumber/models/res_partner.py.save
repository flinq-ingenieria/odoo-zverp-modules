from odoo import api, fields, models
from odoo.exceptions import ValidationError

def _get_next_account(self, account_type, prefix, partner_name):
    """
    Fetch the next available account number based on the account type, prefix, and partner name.
    :param account_type: 'asset_receivable' or 'liability_payable'
    :param prefix: The prefix for the account number (e.g., '430' or '400')
    :param partner_name: The name of the partner for which the account is created
    :return: Account.account record
    """
    Account = self.env['account.account']

    # Determinar el tipo de cuenta según el parámetro account_type
    if account_type == 'asset_receivable':
        account_type_ref = 'account.data_account_type_receivable'
    elif account_type == 'liability_payable':
        account_type_ref = 'account.data_account_type_payable'
    else:
        raise ValueError("Invalid account_type. Must be 'asset_receivable' or 'liability_payable'.")

    # Obtener el tipo de cuenta relacionado
    account_type_id = self.env.ref(account_type_ref).id

    # Buscar la última cuenta creada con el prefijo y tipo
    domain = [
        ('code', '=like', f"{prefix}%"),
        ('user_type_id', '=', account_type_id)
    ]
    last_account = Account.search(domain, order='code desc', limit=1)

    # Generar el siguiente código
    if last_account:
        next_code = int(last_account.code) + 1
    else:
        next_code = int(prefix + '000001')

    # Crear la cuenta contable con el nombre del cliente
    account = Account.create({
        'name': f"{account_type.capitalize().replace('_', ' ')} - {partner_name} ({next_code})",
        'code': str(next_code),
        'user_type_id': account_type_id,
        'reconcile': True,
    })

    return account

@api.model
def create(self, vals):
    # Check if the contact is a company
    if vals.get('is_company', False):
        partner_name = vals.get('name', 'Unnamed Partner')

        # Get the next receivable account
        receivable_account = self._get_next_account('asset_receivable', '430', partner_name)
        # Get the next payable account
        payable_account = self._get_next_account('liability_payable', '400', partner_name)

        # Set the accounts in the contact
        vals['property_account_receivable_id'] = receivable_account.id
        vals['property_account_payable_id'] = payable_account.id

    return super(ResPartner, self).create(vals)
